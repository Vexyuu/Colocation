{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe - CoLive{% endblock %}

{% block body %}
<style>
    body {
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: radial-gradient(circle at top right, rgba(224, 242, 254, 0.6), #f8fafc);
        color: #0f172a;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow-x: hidden;
    }

    .reset-container {
        width: 100%;
        max-width: 440px;
        padding: 1rem;
    }

    .reset-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(15, 23, 42, 0.06);
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .reset-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 25px 50px -12px rgba(2, 132, 199, 0.12);
    }

    .logo {
        text-align: center;
        margin-bottom: 2rem;
    }

    .logo h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin: 0;
        background: linear-gradient(135deg, #0284c7, #059669);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.05em;
    }

    .logo p {
        color: #64748b;
        font-size: 0.95rem;
        margin-top: 0.5rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: #475569;
        margin-bottom: 0.5rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(15, 23, 42, 0.12);
        border-radius: 12px;
        color: #0f172a;
        font-size: 0.95rem;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: #0284c7;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }

    .btn-primary {
        width: 100%;
        padding: 0.85rem;
        background: linear-gradient(135deg, #0284c7, #0369a1);
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
        margin-top: 1rem;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #0ea5e9, #0284c7);
        box-shadow: 0 10px 15px -3px rgba(2, 132, 199, 0.3);
    }

    .btn-primary:active {
        transform: scale(0.98);
    }

    .form-errors {
        padding: 0.75rem 1rem;
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.15);
        border-radius: 12px;
        color: #ef4444;
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
        list-style-type: none;
        margin-left: 0;
        padding-left: 0;
    }
</style>

<div class="reset-container">
    <div class="reset-card">
        <div class="logo">
            <h1>CoLive 🏡</h1>
            <p>Définir un nouveau mot de passe</p>
        </div>

        {# Rendu des messages flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" style="
                    background: {{ label == 'success' ? 'rgba(16, 185, 129, 0.08)' : (label == 'info' ? 'rgba(2, 132, 199, 0.08)' : 'rgba(239, 68, 68, 0.08)') }};
                    border: 1px solid {{ label == 'success' ? 'rgba(16, 185, 129, 0.15)' : (label == 'info' ? 'rgba(2, 132, 199, 0.15)' : 'rgba(239, 68, 68, 0.15)') }};
                    color: {{ label == 'success' ? '#059669' : (label == 'info' ? '#0284c7' : '#ef4444') }};
                    padding: 0.75rem 1rem;
                    border-radius: 12px;
                    font-size: 0.875rem;
                    margin-bottom: 1.5rem;
                    line-height: 1.4;
                    word-break: break-all;
                ">
                    {{ message|raw }}
                </div>
            {% endfor %}
        {% endfor %}

        {{ form_start(resetForm) }}
            
            {% if not resetForm.vars.valid %}
                <ul class="form-errors">
                    {# Erreurs globales du formulaire #}
                    {% for error in resetForm.vars.errors %}
                        <li>{{ error.message }}</li>
                    {% endfor %}
                    
                    {# Erreurs des champs (ex: RepeatedType plainPassword) #}
                    {% for child in resetForm.children %}
                        {% for error in child.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                        {# Erreurs des sous-champs (ex: plainPassword.first et plainPassword.second) #}
                        {% for subchild in child.children %}
                            {% for error in subchild.vars.errors %}
                                <li>{{ error.message }}</li>
                            {% endfor %}
                        {% endfor %}
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="form-group">
                <label for="{{ resetForm.plainPassword.first.vars.id }}">Nouveau mot de passe</label>
                {{ form_widget(resetForm.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}

                {# Exigences de sécurité du mot de passe #}
                <div class="password-requirements" style="margin-top: 0.75rem; font-size: 0.8rem; color: #64748b;">
                    <div id="req-length" style="display: flex; align-items: center; gap: 0.35rem; transition: color 0.2s;">
                        <span class="bullet" style="font-size: 0.65rem;">⚪</span> Minimum 8 caractères
                    </div>
                    <div id="req-char" style="display: flex; align-items: center; gap: 0.35rem; transition: color 0.2s; margin-top: 0.25rem;">
                        <span class="bullet" style="font-size: 0.65rem;">⚪</span> Au moins un chiffre ou caractère spécial
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="{{ resetForm.plainPassword.second.vars.id }}">Confirmez le nouveau mot de passe</label>
                {{ form_widget(resetForm.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
            </div>

            <button type="submit" class="btn-primary">Enregistrer le mot de passe</button>
        {{ form_end(resetForm) }}
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const passwordInput = document.getElementById('{{ resetForm.plainPassword.first.vars.id }}');
        const reqLength = document.getElementById('req-length');
        const reqChar = document.getElementById('req-char');

        if (passwordInput) {
            passwordInput.addEventListener('input', () => {
                const val = passwordInput.value;

                if (val.length === 0) {
                    reqLength.style.color = '#64748b';
                    reqLength.querySelector('.bullet').innerText = '⚪';
                    reqChar.style.color = '#64748b';
                    reqChar.querySelector('.bullet').innerText = '⚪';
                    return;
                }

                // Length check
                if (val.length >= 8) {
                    reqLength.style.color = '#0284c7';
                    reqLength.querySelector('.bullet').innerText = '🟢';
                } else {
                    reqLength.style.color = '#64748b';
                    reqLength.querySelector('.bullet').innerText = '⚪';
                }

                // Chiffre / Char spécial check
                if (/[0-9]/.test(val) || /[^a-zA-Z0-9]/.test(val)) {
                    reqChar.style.color = '#0284c7';
                    reqChar.querySelector('.bullet').innerText = '🟢';
                } else {
                    reqChar.style.color = '#64748b';
                    reqChar.querySelector('.bullet').innerText = '⚪';
                }
            });
        }
    });
</script>
{% endblock %}
