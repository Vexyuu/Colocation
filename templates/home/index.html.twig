{% extends 'base.html.twig' %}

{% block title %}{{ 'home.meta_title'|trans({}, 'messages') }}{% endblock %}

{% block body %}
<!-- 1. Navigation Header -->
<header class="navbar">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
        <a href="{{ path('app_home') }}" class="navbar-brand">
            🏡 CoLive
        </a>
        <nav>
            <ul class="navbar-nav">
                <li><a href="#vision">{{ 'nav.vision'|trans }}</a></li>
                <li><a href="#annonces">{{ 'nav.listings'|trans }}</a></li>
                <li><a href="#fonctionnalites">{{ 'nav.features'|trans }}</a></li>
                <li><a href="#faq">{{ 'nav.faq'|trans }}</a></li>
            </ul>
        </nav>
        <div style="display: flex; align-items: center; gap: 1rem;">
            <!-- Theme Toggle Button -->
            <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle Theme" style="margin-right: 0.25rem;">
                <span class="theme-toggle-icon">🌙</span>
            </button>

            <!-- Language Switcher -->
            <div style="display: flex; gap: 0.5rem; font-size: 0.85rem; font-weight: 600;">

                <a href="{{ path('app_home', {'_locale': 'fr'}) }}" style="color: {{ app.request.locale == 'fr' ? '#059669' : '#64748b' }}; text-decoration: none;">FR</a>
                <span style="color: #cbd5e1;">|</span>
                <a href="{{ path('app_home', {'_locale': 'en'}) }}" style="color: {{ app.request.locale == 'en' ? '#059669' : '#64748b' }}; text-decoration: none;">EN</a>
            </div>

            {% if app.user %}
                <a href="{{ path('app_login_success') }}" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem;">{{ 'nav.my_space'|trans }}</a>
                <a href="{{ path('app_logout') }}" class="btn btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.85rem;">{{ 'nav.logout'|trans }}</a>
            {% else %}
                <a href="{{ path('app_register') }}" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem;">{{ 'nav.register'|trans }}</a>
                <a href="{{ path('app_login') }}" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.85rem;">{{ 'nav.login'|trans }}</a>
            {% endif %}
        </div>
    </div>
</header>

<main>
    <!-- 2. Hero Section -->
    <section id="vision" class="hero">
        <div class="container">
            <h2>{{ 'hero.title_part1'|trans }} <span class="hero-highlight">{{ 'hero.title_highlight'|trans }}</span></h2>
            <p>{{ 'hero.subtitle'|trans }}</p>
            <div class="hero-actions">
                {% if app.user %}
                    <a href="{{ path('app_login_success') }}" class="btn btn-primary">{{ 'hero.btn_dashboard'|trans }}</a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn-primary">{{ 'hero.btn_register'|trans }}</a>
                    <a href="#annonces" class="btn btn-secondary">{{ 'hero.btn_discover'|trans }}</a>
                {% endif %}
            </div>
        </div>
    </section>

    <!-- 3. Annonces Section (NEW & DYNAMIC) -->
    <section id="annonces" class="features-section" style="background: var(--color-bg-darker); border-top: 1px solid var(--border-glow);">
        <div class="container">
            <div class="section-header">
                <h3>{{ 'listings.section_title'|trans }}</h3>
                <p>{{ 'listings.section_subtitle'|trans }}</p>
            </div>

            {% if annonces is empty %}
                <div style="text-align: center; padding: 3rem; background: var(--color-bg-dark); border-radius: 16px; border: 1px dashed var(--border-glow);">
                    <span style="font-size: 3rem;">📭</span>
                    <h4 style="margin-top: 1rem; font-size: 1.2rem; color: var(--color-text-primary);">{{ 'listings.empty_title'|trans }}</h4>
                    <p style="color: var(--color-text-secondary); max-width: 400px; margin: 0.5rem auto 0 auto;">{{ 'listings.empty_desc'|trans }}</p>
                </div>
            {% else %}
                <div class="features-grid">
                    {% for ad in annonces %}
                        <div class="feature-card" style="padding: 0; overflow: hidden; border-radius: 20px; background: var(--color-bg-dark); display: flex; flex-direction: column; height: 100%;">

                            {# Photo Upload Showcase #}
                            {% if ad.photoFilename %}
                                <img src="{{ asset('uploads/photos/' ~ ad.photoFilename) }}" alt="{{ ad.title }}" style="width: 100%; height: 200px; object-fit: cover;">
                            {% else %}
                                <div style="width: 100%; height: 200px; background: linear-gradient(135deg, #e0f2fe, #bae6fd); display: flex; align-items: center; justify-content: center; font-size: 4rem;">
                                    🛏️
                                </div>
                            {% endif %}

                            <div style="padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1;">
                                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                                    <span style="background: rgba(2, 132, 199, 0.08); color: var(--color-secondary); padding: 0.25rem 0.5rem; border-radius: 6px; font-size: 0.8rem; font-weight: 700;">
                                        {{ ad.surface }} m²
                                    </span>
                                    <span style="color: var(--color-primary); font-weight: 800; font-size: 1.15rem;">
                                        {{ ad.price }} €/mois
                                    </span>
                                </div>
                                <h4 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--color-text-primary);">{{ ad.title }}</h4>
                                <p style="font-size: 0.88rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: 1.5rem; flex-grow: 1;">
                                    {{ ad.description|slice(0, 120) }}{{ ad.description|length > 120 ? '...' : '' }}
                                </p>
                                
                                <div style="border-top: 1px solid var(--border-glow); padding-top: 1rem; display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; color: var(--color-text-muted);">
                                    <span>📍 {{ ad.appartement.nom }}</span>
                                    <span>👤 {{ ad.author.firstName }}</span>
                                </div>

                                <div style="margin-top: 1rem;">
                                    {% if app.user %}
                                        <a href="{{ path('app_login_success') }}" class="btn btn-primary" style="width: 100%; padding: 0.6rem; font-size: 0.85rem;">{{ 'listings.btn_contact'|trans }}</a>
                                    {% else %}
                                        <a href="{{ path('app_login') }}" class="btn btn-outline" style="width: 100%; padding: 0.6rem; font-size: 0.85rem;">{{ 'listings.btn_login_contact'|trans }}</a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    <!-- 4. Features Section -->
    <section id="fonctionnalites" class="features-section">
        <div class="container">
            <div class="section-header">
                <h3>{{ 'features.title'|trans }}</h3>
                <p>{{ 'features.subtitle'|trans }}</p>
            </div>
            
            <div class="features-grid">
                <!-- Card 1 -->
                <div class="feature-card">
                    <div class="feature-icon">📐</div>
                    <h4>{{ 'features.tantieme_title'|trans }}</h4>
                    <p>{{ 'features.tantieme_desc'|trans }}</p>
                </div>
                
                <!-- Card 2 -->
                <div class="feature-card primary-accent">
                    <div class="feature-icon">🧹</div>
                    <h4>{{ 'features.chores_title'|trans }}</h4>
                    <p>{{ 'features.chores_desc'|trans }}</p>
                </div>
                
                <!-- Card 3 -->
                <div class="feature-card">
                    <div class="feature-icon">📄</div>
                    <h4>{{ 'features.finances_title'|trans }}</h4>
                    <p>{{ 'features.finances_desc'|trans }}</p>
                </div>
                
                <!-- Card 4 -->
                <div class="feature-card primary-accent">
                    <div class="feature-icon">💬</div>
                    <h4>{{ 'features.messaging_title'|trans }}</h4>
                    <p>{{ 'features.messaging_desc'|trans }}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. FAQ Section -->
    <section id="faq" class="faq-section">
        <div class="container">
            <div class="section-header">
                <h3>{{ 'faq.title'|trans }}</h3>
                <p>{{ 'faq.subtitle'|trans }}</p>
            </div>
            
            <div class="faq-wrapper">
                <details class="faq-item">
                    <summary class="faq-question">{{ 'faq.q1'|trans }}</summary>
                    <div class="faq-answer">
                        {{ 'faq.a1'|trans }}
                    </div>
                </details>

                <details class="faq-item">
                    <summary class="faq-question">{{ 'faq.q2'|trans }}</summary>
                    <div class="faq-answer">
                        {{ 'faq.a2'|trans }}
                    </div>
                </details>

                <details class="faq-item">
                    <summary class="faq-question">{{ 'faq.q3'|trans }}</summary>
                    <div class="faq-answer">
                        {{ 'faq.a3'|trans }}
                    </div>
                </details>

                <details class="faq-item">
                    <summary class="faq-question">{{ 'faq.q4'|trans }}</summary>
                    <div class="faq-answer">
                        {{ 'faq.a4'|trans }}
                    </div>
                </details>
            </div>
        </div>
    </section>
</main>

<!-- 6. Footer -->
<footer class="footer">
    <div class="container">
        <p>{{ 'footer.copyright'|trans }}</p>
        <p style="margin-top: 0.5rem; font-size: 0.8rem; color: #475569;">{{ 'footer.tagline'|trans }}</p>
        <div style="margin-top: 1rem; display: flex; justify-content: center; gap: 1.5rem; font-size: 0.85rem; font-weight: 600;">
            <a href="{{ path('app_legal') }}" style="color: var(--color-secondary);">
                {{ 'footer.legal_links'|trans }}
            </a>
        </div>
        <div class="footer-green-badge">
            🍃 {{ 'footer.green_badge'|trans }}
        </div>
    </div>
</footer>
{% endblock %}

