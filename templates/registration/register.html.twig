{% extends 'base.html.twig' %}

{% block title %}Inscription - CoLive{% endblock %}

{% block body %}
<style>
    body {
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: radial-gradient(circle at top right, rgba(224, 242, 254, 0.6), #f8fafc);
        color: #0f172a;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow-y: auto;
        padding: 2rem 0;
    }

    .register-container {
        width: 100%;
        max-width: 500px;
        padding: 1rem;
    }

    .register-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(15, 23, 42, 0.06);
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .register-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 25px 50px -12px rgba(5, 150, 105, 0.12);
    }

    .logo {
        text-align: center;
        margin-bottom: 2rem;
    }

    .logo h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin: 0;
        background: linear-gradient(135deg, #059669, #0284c7);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.05em;
    }

    .logo p {
        color: #64748b;
        font-size: 0.95rem;
        margin-top: 0.5rem;
    }

    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .form-group {
        margin-bottom: 1.25rem;
        position: relative;
    }

    .form-group label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: #475569;
        margin-bottom: 0.5rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(15, 23, 42, 0.12);
        border-radius: 12px;
        color: #0f172a;
        font-size: 0.95rem;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }

    /* Radio buttons for Role Selection */
    .role-selection {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .role-card {
        background: rgba(15, 23, 42, 0.03);
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 12px;
        padding: 1rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .role-card:hover {
        border-color: rgba(5, 150, 105, 0.4);
        background: rgba(15, 23, 42, 0.06);
    }

    .role-card input[type="radio"] {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .role-icon {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .role-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: #475569;
    }

    .role-card.selected {
        border-color: #059669;
        background: rgba(5, 150, 105, 0.05);
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }

    .role-card.selected .role-title {
        color: #059669;
    }

    /* Password Strength styling */
    .strength-wrapper {
        margin-top: 0.5rem;
    }

    .strength-bar-bg {
        height: 6px;
        background: rgba(15, 23, 42, 0.06);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 0.35rem;
    }

    .strength-bar {
        height: 100%;
        width: 0;
        border-radius: 3px;
        transition: width 0.3s ease, background-color 0.3s ease;
    }

    .strength-label {
        font-size: 0.75rem;
        color: #64748b;
        display: flex;
        justify-content: space-between;
    }

    .btn-primary {
        width: 100%;
        padding: 0.85rem;
        background: linear-gradient(135deg, #059669, #047857);
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        margin-top: 1.5rem;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #059669, #0284c7);
        box-shadow: 0 10px 15px -3px rgba(5, 150, 105, 0.3);
    }

    .btn-primary:active {
        transform: scale(0.98);
    }

    .form-errors {
        padding: 0.75rem 1rem;
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.15);
        border-radius: 12px;
        color: #ef4444;
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
        list-style-type: none;
        margin-left: 0;
    }

    .footer-links {
        margin-top: 1.5rem;
        text-align: center;
        font-size: 0.875rem;
    }

    .footer-links a {
        color: #059669;
        text-decoration: none;
        transition: color 0.2s;
    }

    .footer-links a:hover {
        color: #0284c7;
        text-decoration: underline;
    }
</style>

<div class="register-container">
    <div class="register-card">
        <div class="logo">
            <h1>CoLive 🏡</h1>
            <p>Créez votre compte en quelques secondes</p>
        </div>

        {{ form_start(registrationForm, {'attr': {'id': 'register-form'}}) }}

            {# Global errors if any #}
            {% if not registrationForm.vars.valid %}
                <ul class="form-errors">
                    {% for child in registrationForm.children %}
                        {% for error in child.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="form-row-2">
                <div class="form-group">
                    <label for="{{ registrationForm.firstName.vars.id }}">Prénom</label>
                    {{ form_widget(registrationForm.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Jean'}}) }}
                </div>
                <div class="form-group">
                    <label for="{{ registrationForm.lastName.vars.id }}">Nom</label>
                    {{ form_widget(registrationForm.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Dupond'}}) }}
                </div>
            </div>

            <div class="form-group">
                <label for="{{ registrationForm.email.vars.id }}">Adresse Email</label>
                {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@colive.fr'}}) }}
            </div>

            <fieldset class="form-group">
                <legend class="col-form-label pt-0">Vous êtes...</legend>
                <div class="role-selection">
                    {% for child in registrationForm.role %}
                        <label class="role-card" for="{{ child.vars.id }}" id="role-card-{{ child.vars.value }}">
                            {{ form_widget(child) }}
                            <div class="role-icon">
                                {% if child.vars.value == 'ROLE_TENANT' %}
                                    👤
                                {% else %}
                                    🔑
                                {% endif %}
                            </div>
                            <span class="role-title">{{ child.vars.label }}</span>
                        </label>
                    {% endfor %}
                </div>
            </fieldset>

            <div class="form-group">
                <label for="{{ registrationForm.plainPassword.vars.id }}">Mot de passe</label>
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                
                {# Password strength visualization #}
                <div class="strength-wrapper">
                    <div class="strength-bar-bg">
                        <div class="strength-bar" id="strength-bar"></div>
                    </div>
                    <div class="strength-label">
                        <span id="strength-text">Saisissez un mot de passe</span>
                        <span id="strength-percent">0%</span>
                    </div>
                </div>

                {# Exigences de sécurité du mot de passe #}
                <div class="password-requirements" style="margin-top: 0.75rem; font-size: 0.8rem; color: #64748b;">
                    <div id="req-length" style="display: flex; align-items: center; gap: 0.35rem; transition: color 0.2s;">
                        <span class="bullet" style="font-size: 0.65rem;">⚪</span> Minimum 8 caractères
                    </div>
                    <div id="req-char" style="display: flex; align-items: center; gap: 0.35rem; transition: color 0.2s; margin-top: 0.25rem;">
                        <span class="bullet" style="font-size: 0.65rem;">⚪</span> Au moins un chiffre ou caractère spécial
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-primary">Créer mon compte</button>

        {{ form_end(registrationForm) }}

        <div class="footer-links">
            Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
        </div>
    </div>
</div>

<script>
    const initRegisterPage = () => {
        // --- 1. Role Cards Selection UI ---
        const roleCards = document.querySelectorAll('.role-card');
        const radios = document.querySelectorAll('.role-card input[type="radio"]');

        const updateSelectedRoleCard = () => {
            roleCards.forEach(card => {
                const radio = card.querySelector('input[type="radio"]');
                if (radio && radio.checked) {
                    card.classList.add('selected');
                } else {
                    card.classList.remove('selected');
                }
            });
        };

        // Initial state
        updateSelectedRoleCard();

        // Listen for change on radios
        radios.forEach(radio => {
            radio.addEventListener('change', updateSelectedRoleCard);
        });

        // --- 2. Password Strength Indicator ---
        const passwordInput = document.getElementById('{{ registrationForm.plainPassword.vars.id }}');
        const strengthBar = document.getElementById('strength-bar');
        const strengthText = document.getElementById('strength-text');
        const strengthPercent = document.getElementById('strength-percent');

        if (passwordInput) {
            const reqLength = document.getElementById('req-length');
            const reqChar = document.getElementById('req-char');

            passwordInput.addEventListener('input', () => {
                const val = passwordInput.value;
                let score = 0;

                if (val.length === 0) {
                    if (strengthBar) {
                        strengthBar.style.width = '0%';
                        strengthBar.style.backgroundColor = 'transparent';
                    }
                    if (strengthText) {
                        strengthText.innerText = 'Saisissez un mot de passe';
                        strengthText.style.color = '#64748b';
                    }
                    if (strengthPercent) {
                        strengthPercent.innerText = '0%';
                    }
                    if (reqLength) {
                        reqLength.style.color = '#64748b';
                        reqLength.querySelector('.bullet').innerText = '⚪';
                    }
                    if (reqChar) {
                        reqChar.style.color = '#64748b';
                        reqChar.querySelector('.bullet').innerText = '⚪';
                    }
                    return;
                }

                // Dynamic Requirements Checklist
                if (val.length >= 8) {
                    if (reqLength) {
                        reqLength.style.color = '#059669';
                        reqLength.querySelector('.bullet').innerText = '🟢';
                    }
                } else {
                    if (reqLength) {
                        reqLength.style.color = '#64748b';
                        reqLength.querySelector('.bullet').innerText = '⚪';
                    }
                }

                if (/[0-9]/.test(val) || /[^a-zA-Z0-9]/.test(val)) {
                    if (reqChar) {
                        reqChar.style.color = '#059669';
                        reqChar.querySelector('.bullet').innerText = '🟢';
                    }
                } else {
                    if (reqChar) {
                        reqChar.style.color = '#64748b';
                        reqChar.querySelector('.bullet').innerText = '⚪';
                    }
                }

                // Length points
                if (val.length >= 8) score += 20;
                if (val.length >= 12) score += 10;
                
                // Complexity points
                if (/[a-z]/.test(val)) score += 15; // Lowercase
                if (/[A-Z]/.test(val)) score += 15; // Uppercase
                if (/[0-9]/.test(val)) score += 20; // Number
                if (/[^a-zA-Z0-9]/.test(val)) score += 20; // Special char

                // Render bar
                if (strengthBar) {
                    strengthBar.style.width = score + '%';
                }
                if (strengthPercent) {
                    strengthPercent.innerText = score + '%';
                }

                if (score <= 35) {
                    if (strengthBar) strengthBar.style.backgroundColor = '#ef4444'; // Red
                    if (strengthText) {
                        strengthText.innerText = 'Très faible ❌';
                        strengthText.style.color = '#ef4444';
                    }
                } else if (score <= 65) {
                    if (strengthBar) strengthBar.style.backgroundColor = '#f59e0b'; // Amber
                    if (strengthText) {
                        strengthText.innerText = 'Moyen ⚠️';
                        strengthText.style.color = '#d97706';
                    }
                } else if (score <= 85) {
                    if (strengthBar) strengthBar.style.backgroundColor = '#3b82f6'; // Blue
                    if (strengthText) {
                        strengthText.innerText = 'Fort 🛡️';
                        strengthText.style.color = '#2563eb';
                    }
                } else {
                    if (strengthBar) strengthBar.style.backgroundColor = '#10b981'; // Green
                    if (strengthText) {
                        strengthText.innerText = 'Très fort ! 💪';
                        strengthText.style.color = '#059669';
                    }
                }
            });
        }
    };

    // Support both Turbo navigation loads and initial document loads
    document.addEventListener('DOMContentLoaded', initRegisterPage);
    document.addEventListener('turbo:load', initRegisterPage);
</script>
{% endblock %}
